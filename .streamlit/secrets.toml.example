# Configurações de Secrets para Streamlit Cloud
# Use estes valores nas configurações de secrets do Streamlit Cloud

# Senha administrativa
DASH_SENHA = "sua_senha_super_secreta"

# Configurações de debug
DEBUG = false

# Configurações de log
LOG_LEVEL = "INFO"

# Nota: O banco SQLite (integracoes.db) será carregado automaticamente
# junto com o código do repositório